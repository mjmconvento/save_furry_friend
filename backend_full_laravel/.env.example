APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The API is published by nginx on :8081 (compose NGINX_PORT).
APP_URL=http://localhost:8081

# Origin of the React SPA; drives config/cors.php allowed_origins. Laravel reads
# it from this file — compose does not interpolate it — so it must be moved here
# by hand whenever the SPA's published port (compose REACT_PORT) changes. See
# docker-compose.override.yml.example before remapping it.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Hostnames are compose service names; credentials must match POSTGRES_DB /
# POSTGRES_USER / POSTGRES_PASSWORD in the root .env.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=blog
DB_USERNAME=root
DB_PASSWORD=password

# Mongo runs with authentication enabled; credentials must match
# MONGO_ROOT_USER / MONGO_ROOT_PASSWORD in the root .env.
MONGODB_URI=mongodb://admin:password@mongo:27017
MONGODB_DATABASE=sff
MONGODB_USERNAME=admin
MONGODB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO credentials and bucket; must match MINIO_ROOT_USER /
# MINIO_ROOT_PASSWORD / MINIO_BUCKET in the root .env.
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=uploads
AWS_ENDPOINT=http://minio:9000
# Browser-reachable base URL for the bucket; Storage::disk('s3')->url() uses it.
# The port is compose MINIO_API_PORT, not the container's 9000.
AWS_URL=http://localhost:9101/uploads
AWS_USE_PATH_STYLE_ENDPOINT=true
