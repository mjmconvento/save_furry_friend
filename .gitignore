/ai_docs
/.ai
/.idea

# Agent skill packs and their output, installed per machine with
# `npx impeccable install`. Same payload twice (.pi and .claude), ~3.4M each,
# and regenerated by the installer - so it is tooling, not source.
/.pi
/.claude
/.impeccable
/.github/hooks

# Compose credentials (interpolated into docker-compose.yml); copy from
# .env.docker.example.
/.env

# Local-only compose tweaks such as port remaps; copy from
# docker-compose.override.yml.example.
/docker-compose.override.yml
