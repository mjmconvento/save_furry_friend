/ai_docs
/.ai
/.idea

# Agent skill packs and their output, installed per machine with
# `npx impeccable install`. Same payload twice (.pi and .claude/skills), ~3.4M
# each, and regenerated by the installer - so it is tooling, not source.
/.pi
/.impeccable
/.github/hooks

# Claude Code: the project config is committed (see CLAUDE.md); per-machine
# state (settings.local.json, .cache) and installer-dropped skills are not.
# A new project skill needs its own `!` line below.
/.claude/*
!/.claude/settings.json
!/.claude/rules/
!/.claude/hooks/
!/.claude/agents/
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/api-endpoint/
!/.claude/skills/data-migration/
!/.claude/skills/ci-check/
__pycache__/

# Compose credentials (interpolated into docker-compose.yml); copy from
# .env.docker.example.
/.env

# Local-only compose tweaks such as port remaps; copy from
# docker-compose.override.yml.example.
/docker-compose.override.yml
