# Compose-only configuration. Copy to ./.env before the first `up`:
#
#     cp .env.docker.example .env
#
# docker-compose.yml interpolates these; they are NOT injected into containers
# unless a service references them explicitly. The application's own settings
# live in backend_full_laravel/.env.
#
# Every credential below is a local development default. Change them for
# anything reachable by another machine.

# --- Postgres -----------------------------------------------------------------
POSTGRES_DB=blog
POSTGRES_USER=root
POSTGRES_PASSWORD=password
# Published on 127.0.0.1 only, for a local psql client.
POSTGRES_PORT=5432

# --- MongoDB ------------------------------------------------------------------
# Not published to the host at all; use `docker compose exec mongo mongosh`.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password

# --- MinIO --------------------------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_BUCKET=uploads
# The API port must match AWS_URL in backend_full_laravel/.env, because the
# browser fetches media straight from MinIO.
#
# 9101/9102 rather than MinIO's conventional 9000/9001: those, plus 9090, are
# routinely taken by other local stacks, and a clash aborts the whole `up`.
# Change both here and AWS_URL together.
MINIO_API_PORT=9101
MINIO_CONSOLE_PORT=9102

# --- Host ports ---------------------------------------------------------------
# NGINX_PORT also feeds the SPA's VITE_API_BASE_URL.
NGINX_PORT=8081
REACT_PORT=3000

# Moving REACT_PORT also means moving FRONTEND_URL in
# backend_full_laravel/.env - config/cors.php reads it from the application's
# own env, not from here, so the two files have to agree or login fails the
# CORS preflight with nothing in the Laravel log.
